{
  "name": "@zarr20/rakit-ui",
  "version": "1.1.0",
  "description": "Enterprise UI Component Library - Rakit UI",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/rakit-ui.css",
    "./style.css": "./dist/rakit-ui.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.54.0",
    "prismjs": "^1.30.0",
    "react-runner": "^1.0.5",
    "tailwind-merge": "^3.0.2"
  },
  "keywords": [
    "react",
    "ui",
    "components",
    "rakit-ui",
    "@zarr20/rakit-ui",
    "tailwind",
    "enterprise-ui"
  ],
  "author": "Rakit (Dzarr Al Ghifari)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zarr20/rakit-ui.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "pack": "npm pack",
    "publish:dry": "npm publish --dry-run",
    "publish:public": "npm publish --access public"
  }
}
